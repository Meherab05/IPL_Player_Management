<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.huhuhahahihi.HomeController">

    <!-- Background Image -->
    <children>
        <ImageView fitHeight="622.0" fitWidth="904.0" pickOnBounds="true" preserveRatio="true">
            <image>
                <Image url="@homebg.jpg" />
            </image>
        </ImageView>

        <!-- Content -->
        <VBox alignment="CENTER" spacing="30" style="-fx-padding: 30;">
            <!-- Title -->
            <Label style="-fx-font-size: 36px; -fx-font-weight: bold; -fx-text-fill: #FFD700; -fx-effect: dropshadow(gaussian, black, 5, 0.8, 0, 2);" text="Player Management System" />

            <!-- Buttons in GridPane -->
            <GridPane alignment="CENTER" hgap="20" style="-fx-padding: 20;" vgap="20">
                <rowConstraints>
                    <RowConstraints minHeight="50" />
                    <RowConstraints minHeight="50" />
                    <RowConstraints minHeight="50" />
                </rowConstraints>
                <columnConstraints>
                    <ColumnConstraints minWidth="160.0" />
                    <ColumnConstraints minWidth="160.0" />
                    <ColumnConstraints minWidth="160.0" />
                </columnConstraints>

                <!-- Existing Buttons -->
                <Button fx:id="searchPlayersButton" onAction="#SearchPlayers" prefWidth="160" style="-fx-background-color: linear-gradient(to right, #43cea2, #185a9d);                                -fx-text-fill: white; -fx-font-size: 16;                                -fx-font-weight: bold; -fx-padding: 8;                                -fx-border-radius: 12; -fx-background-radius: 12;                                -fx-cursor: hand; -fx-effect: dropshadow(gaussian, black, 3, 0.4, 1, 1);" text="Search Players" GridPane.columnIndex="0" GridPane.rowIndex="0" />

                <Button fx:id="searchClubsButton" onAction="#clubSearch" prefWidth="160" style="-fx-background-color: linear-gradient(to right, #43cea2, #185a9d);                                -fx-text-fill: white; -fx-font-size: 16;                                -fx-font-weight: bold; -fx-padding: 8;                                -fx-border-radius: 12; -fx-background-radius: 12;                                -fx-cursor: hand; -fx-effect: dropshadow(gaussian, black, 3, 0.4, 1, 1);" text="Search Clubs" GridPane.columnIndex="2" />

                <Button fx:id="addPlayerButton" onAction="#add" prefWidth="160" style="-fx-background-color: linear-gradient(to right, #11998e, #38ef7d);                                -fx-text-fill: white; -fx-font-size: 16;                                -fx-font-weight: bold; -fx-padding: 8;                                -fx-border-radius: 12; -fx-background-radius: 12;                                -fx-cursor: hand; -fx-effect: dropshadow(gaussian, black, 3, 0.4, 1, 1);" text="Add Player" GridPane.columnIndex="0" GridPane.rowIndex="1" />

                <Button fx:id="clubLoginButton" onAction="#clubLogin" prefWidth="160" style="-fx-background-color: linear-gradient(to right, #ff8008, #ffc837);                                -fx-text-fill: white; -fx-font-size: 16;                                -fx-font-weight: bold; -fx-padding: 8;                                -fx-border-radius: 12; -fx-background-radius: 12;                                -fx-cursor: hand; -fx-effect: dropshadow(gaussian, black, 3, 0.4, 1, 1);" text="Club Login" GridPane.columnIndex="2" GridPane.rowIndex="1" />

                <!-- Corrected Exit Button -->
                <Button fx:id="exitButton" onAction="#Exit" prefWidth="160" style="-fx-background-color: linear-gradient(to right, #ff416c, #ff4b2b);                                -fx-text-fill: white; -fx-font-size: 16;                                -fx-font-weight: bold; -fx-padding: 8;                                -fx-border-radius: 12; -fx-background-radius: 12;                                -fx-cursor: hand; -fx-effect: dropshadow(gaussian, black, 3, 0.4, 1, 1);" text="Exit" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            </GridPane>
        </VBox>
    </children>
</StackPane>