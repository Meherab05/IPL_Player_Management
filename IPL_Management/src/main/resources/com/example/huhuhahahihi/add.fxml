<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="500.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.huhuhahahihi.add">
    <children>

        <!-- Input field for Player Name -->
        <TextField fx:id="nameField" layoutY="10.0" prefHeight="25.0" prefWidth="900.0" promptText="Enter Player Name" />

        <!-- Input field for Country -->
        <TextField fx:id="countryField" layoutY="50.0" prefHeight="25.0" prefWidth="900.0" promptText="Enter Country" />

        <!-- Input field for Age -->
        <TextField fx:id="ageField" layoutY="90.0" prefHeight="25.0" prefWidth="900.0" promptText="Enter Age" />

        <!-- Input field for Height -->
        <TextField fx:id="heightField" layoutY="130.0" prefHeight="25.0" prefWidth="900.0" promptText="Enter Height" />

        <!-- Input field for Club -->
        <TextField fx:id="clubField" layoutY="170.0" prefHeight="25.0" prefWidth="900.0" promptText="Enter Club" />

        <!-- Dropdown for Position -->
        <ComboBox fx:id="positionComboBox" layoutY="210.0" prefHeight="25.0" prefWidth="900.0" promptText="Select Position">
            <items>
                <FXCollections fx:factory="observableArrayList">
                    <String fx:value="Batsman" />
                    <String fx:value="Bowler" />
                    <String fx:value="All-rounder" />
                    <String fx:value="Wicketkeeper" />
                </FXCollections>
            </items>
        </ComboBox>

        <!-- Input field for Jersey Number -->
        <TextField fx:id="jerseyNumberField" layoutY="250.0" prefHeight="25.0" prefWidth="900.0" promptText="Enter Jersey Number" />

        <!-- Input field for Salary -->
        <TextField fx:id="salaryField" layoutY="290.0" prefHeight="25.0" prefWidth="900.0" promptText="Enter Salary" />

        <!-- Submit Button -->
        <Button fx:id="submitButton" layoutX="402.0" layoutY="330.0" mnemonicParsing="false" onAction="#submit" prefHeight="40.0" prefWidth="100.0" text="Submit" />

        <!-- Back Button -->
        <Button fx:id="backButton" layoutX="402.0" layoutY="446.0" mnemonicParsing="false" onAction="#back" prefHeight="40.0" prefWidth="100.0" text="Back" />

        <!-- Output TextArea -->
        <TextArea fx:id="outputArea" layoutY="403.0" prefHeight="40.0" prefWidth="900.0" wrapText="true" />
    </children>
</AnchorPane>
